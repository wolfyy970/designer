# Logs (keep agent snapshot readable by AI tools in workspace)
logs/
!logs/agent-snapshot.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules

# Local mirror of upstream Pi (exploration only; not part of this repo)
.vendor/

dist
dist-ssr
*.local

# Test files
test*.html

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.cursor/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Experiments tool — preserve folder skeletons but ignore generated runs and cost ledger
experiments/runs/*
!experiments/runs/.gitkeep
experiments/matrix/*
!experiments/matrix/.gitkeep
experiments/.cost-ledger.jsonl

# Claude Code project workspace — keep skills (commit-worthy), ignore user/runtime artifacts
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/.local/

# Excel temp lock files
~$*

# Standard rules added for health
.env
.env.local
build/

# Local agent scratch (screenshots, one-off driver scripts) — never commit-worthy
.dsh-scratch/
